POSTGRES_PASSWORD=replace_with_generated_password
DATABASE_URL=postgresql+psycopg://contextos:replace_with_generated_password@db:5432/contextos
# Managed Postgres providers such as Neon supply a direct URL for migrations.
DATABASE_URL_UNPOOLED=postgresql+psycopg://contextos:replace_with_generated_password@db:5432/contextos
OPENAI_API_KEY=use_a_secret_manager
OPENAI_GENERATION_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_RETRIES=1
RETRIEVAL_TOP_K=5
PROJECT_STORE=postgres
HISTORICAL_STORE=postgres
CONTEXTOS_ENV=production
DEMO_MODE=true
DEMO_WRITE_ENABLED=false
CORS_ALLOWED_ORIGINS=https://replace-with-frontend-origin.example
AI_RATE_LIMIT_PER_MINUTE=10
WRITE_RATE_LIMIT_PER_MINUTE=30
