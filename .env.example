OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_RETRIES=1
RETRIEVAL_TOP_K=5
DATABASE_URL=postgresql+psycopg://contextos:contextos@localhost:5432/contextos
HISTORICAL_STORE=postgres
PROJECT_STORE=postgres
CONTEXTOS_ENV=development
DEMO_MODE=true
DEMO_WRITE_ENABLED=true
# Optional prototype-only write guard. Never expose this value to the frontend.
DEMO_OPERATOR_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_RATE_LIMIT_PER_MINUTE=10
WRITE_RATE_LIMIT_PER_MINUTE=30

